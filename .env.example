# Copiar a .env y completar. NUNCA commitear .env

# --- Base de datos ---
POSTGRES_USER=mango
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=mango
DATABASE_URL=postgresql+asyncpg://mango:cambiar@localhost:5432/mango

# --- API ---
# Generar con: openssl rand -hex 32
SECRET_KEY=
API_HOST=127.0.0.1
API_PORT=8000

# --- PowerSync ---
POWERSYNC_URL=http://localhost:8080
# Clave HS256 compartida (base64url) para los JWT que la API firma y PowerSync
# valida. Generar: python -c "import secrets,base64;
# print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
POWERSYNC_JWT_SECRET=
POWERSYNC_JWT_AUDIENCE=powersync
# Storage de buckets de PowerSync (Postgres aparte, dentro de docker).
POWERSYNC_STORAGE_USER=powersync
POWERSYNC_STORAGE_PASSWORD=powersync
POWERSYNC_STORAGE_DB=powersync

# --- Usuario semilla (fase 3a) ---
# En una instalacion NUEVA, el seed crea la cuenta con esta identidad y una
# clave temporal; se entra con ella y hay que cambiarla de una.
SEED_USER_USERNAME=yo
SEED_USER_PASSWORD=mango

# --- Deploy (imagenes en el homelab) ---
# La direccion desde la que ENTRAS a la app (tu navegador, tu telefono): el
# nombre de Tailscale o la IP del homelab. Se hornea en el build del frontend y
# la usa la API para CORS. Si cambia, hay que RECOMPILAR el frontend (ver
# frontend/Dockerfile y decision 0012).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_POWERSYNC_URL=http://localhost:8080
# Origen desde el que se sirve la PWA. JSON: son los origenes permitidos por CORS.
CORS_ORIGINS=["http://localhost:8081"]
# Cuantos dias de respaldos se guardan.
BACKUP_RETENTION_DAYS=14

# --- Ingesta desde n8n ---
# Token de servicio, distinto de las credenciales de usuario
N8N_SERVICE_TOKEN=

# --- Categorizacion con IA (opcional) ---
# Endpoint compatible con OpenAI. Puede apuntar a un gateway propio.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
