# Mango — configuracion del servidor (ver docs/decisiones/0020).
#
# Lo mas simple es NO completar esto a mano: `install.sh` genera el .env con
# secretos al azar. Si preferis hacerlo vos: copiar a .env y completar los tres
# secretos obligatorios. NUNCA commitear el .env.

# --- Secretos (obligatorios) ---
# Contraseña de la base. Solo letras y numeros: va dentro de una URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Firma las sesiones de login.
#   openssl rand -hex 32
SECRET_KEY=
# Clave compartida API <-> PowerSync, en base64url.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
POWERSYNC_JWT_SECRET=
# Base interna de PowerSync (no se publica). Opcional, pero mejor cambiarla.
POWERSYNC_STORAGE_PASSWORD=

# --- Primer usuario ---
# Se crea en la primera instalacion. La clave es TEMPORAL: al entrar, la app
# obliga a cambiarla.
SEED_USER_USERNAME=yo
SEED_USER_PASSWORD=

# --- Opcionales ---
# Puerto por el que se entra a Mango (el unico que se publica).
MANGO_PORT=8081
# Version. 'latest' sigue las actualizaciones (Watchtower o compose pull).
# Para fijar una version o volver atras: el tag del commit (ej. 79e7cc0).
MANGO_TAG=latest
# Registry de las imagenes (si publicas tu propio fork).
# MANGO_REGISTRY=ghcr.io/fedexx5652
# Zona horaria: define en que dia cae un movimiento recurrente.
TZ=America/Argentina/Buenos_Aires
# Dias de respaldos diarios que se guardan.
BACKUP_RETENTION_DAYS=14
